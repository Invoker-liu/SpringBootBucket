<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.xncoding</groupId>
    <artifactId>springboot4-transaction</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>springboot4-transaction</name>
    <description>Spring Boot 4 教程：声明式事务</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Boot 4 中 spring-boot-starter-web 已弃用，改用 webmvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 本篇主角。写成 spring-boot-starter-jdbc 而不是 spring-boot-jdbc，
             是因为 starter 会额外带上 HikariCP（spring-boot-jdbc 本身不含它）。
             spring-tx 是 spring-boot-jdbc 与 mybatis-plus 传递进来的，这里没有显式坐标。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- 数据访问层用 MyBatis-Plus，和第 2 / 第 5 篇保持同一条技术线。
             本篇重点在事务，不在 ORM，所以只用 BaseMapper + 注解 SQL，
             一个 mapper XML 都不写，省得读者在看事务的时候还要翻 SQL 映射文件。
             注意 Boot 4 必须用带 boot4 后缀的 starter。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>

        <!-- MySQL 驱动，版本由 Boot 的 BOM 管理 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 健康检查。除了看数据库连没连上，Actuator 还能反过来告诉我们
             「容器里到底有几个事务管理器、分别是什么类型」，这是本篇的自查手段之一。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 测试：4.x 按特性拆分的 webmvc 测试 starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
