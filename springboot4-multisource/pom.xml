<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.xncoding</groupId>
    <artifactId>springboot4-multisource</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>springboot4-multisource</name>
    <description>Spring Boot 4 教程：多数据源配置</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- MyBatis-Plus 官方 BOM，统一核心包与各附属包的版本 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web MVC：Boot 4 中 spring-boot-starter-web 已弃用，改用 webmvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP。注意 Boot 4 里 spring-boot-starter-aop 这个名字已经不存在了，
             改叫 spring-boot-starter-aspectj。动态切换数据源靠一个 @Aspect 拦注解，
             没有这个 starter 就只有 spring-aop（代理基础设施），@Aspect 不会被识别，
             @DataSource 会静默失效 —— 注解在那儿、切面根本不跑。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- 本篇主角。写成 spring-boot-starter-jdbc 而不是 spring-boot-jdbc，
             是因为 starter 会额外带上 HikariCP（spring-boot-jdbc 本身不含它）。
             注意这个 starter 里【没有】spring-tx 的显式坐标，
             spring-tx 是 spring-boot-jdbc 与 mybatis-plus 传递进来的。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- MyBatis-Plus：Boot 4 必须用带 boot4 后缀的 starter -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>

        <!-- 分页插件自 3.5.9 起从核心包分离 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- MySQL 驱动，版本由 Boot 的 BOM 管理 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 健康检查。多数据源下这个依赖不是可有可无的：
             spring-boot-jdbc 里有一个专门为 AbstractRoutingDataSource 写的
             RoutingDataSourceHealthContributor，/actuator/health 会把路由数据源里
             每个 target 分别展开成独立的条目。
             换句话说，这是 Boot 官方给的「两个库到底连上没有」的现成证据源。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 测试：4.x 按特性拆分的 webmvc 测试 starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
