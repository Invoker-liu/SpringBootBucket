<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.xncoding</groupId>
    <artifactId>springboot4-resilience</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>springboot4-resilience</name>
    <description>Spring Boot 4 教程：Framework 7 内置弹性能力 @Retryable / @ConcurrencyLimit 实测</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web MVC：Boot 4 中 spring-boot-starter-web 已弃用，改用 webmvc。
             弹性注解在 spring-context 的 org.springframework.resilience.annotation 包内，
             spring-boot-starter-webmvc 传递引入 spring-context 与 spring-aop，无需额外依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 测试：webmvc 测试 starter，含 RestTestClient 与 MockMvc 设施 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
