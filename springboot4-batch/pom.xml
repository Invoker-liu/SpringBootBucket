<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.xncoding</groupId>
    <artifactId>springboot4-batch</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>springboot4-batch</name>
    <description>Spring Boot 4 教程：使用批处理 Spring Batch</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web MVC：Boot 4 中 spring-boot-starter-web 已弃用，改用 webmvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 批处理：Boot 4 把 starter 拆成了三层。
             starter-batch = starter + spring-boot-batch（编程模型，默认 ResourcelessJobRepository 零数据库）
             starter-batch-jdbc = starter-batch + starter-jdbc + spring-boot-batch-jdbc
             （JDBC JobRepository + 元数据表自动初始化）。
             要把执行记录落 MySQL，就用 starter-batch-jdbc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch-jdbc</artifactId>
        </dependency>

        <!-- MySQL 驱动（BOM 管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 专属测试 starter（BOM 4.1.1 实证存在）：
             = starter-batch-test（spring-batch-test 的 @SpringBatchTest）+ starter-jdbc-test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- API 集成测试用 MockMvc（注意包名：org.springframework.boot.webmvc.test.autoconfigure） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
