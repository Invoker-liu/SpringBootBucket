<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.xncoding</groupId>
    <artifactId>springboot4-thymeleaf</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>springboot4-thymeleaf</name>
    <description>Spring Boot 4 教程：集成 Thymeleaf 服务端渲染 + 表单校验（列表分页、表单回显、重定向闪属性）</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web MVC 容器与 Spring MVC：Boot 4 中 starter-web 已弃用，一律用 webmvc；
             注意 spring-boot-starter-thymeleaf 只带模板引擎（thymeleaf-spring6 3.1.5.RELEASE），
             不含 spring-webmvc 与 Tomcat，必须显式叠加 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Thymeleaf 自动配置模块 spring-boot-thymeleaf：
             自动配置类在 org.springframework.boot.thymeleaf.autoconfigure（Boot 4 拆包后的新位置） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Bean Validation：hibernate-validator 9.1.3.Final + jakarta.validation-api 3.1.1 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 测试：含 starter-test + MockMvcTester 设施；@AutoConfigureMockMvc 在
             org.springframework.boot.webmvc.test.autoconfigure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
