<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.xncoding</groupId>
    <artifactId>springboot4-echarts</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>springboot4-echarts</name>
    <description>Spring Boot 4 教程：服务端图表数据接口 + ECharts 前端渲染 + 无头浏览器导出 PNG</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web MVC 容器与 Spring MVC：Boot 4 用 webmvc starter（starter-web 已弃用）。
             传递 spring-boot-starter-jackson（tools.jackson 3.1.5），
             LocalDate 直接输出 ISO 字符串、BigDecimal 原样输出，无需额外注册模块 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 测试：starter-test + MockMvcTester + @AutoConfigureMockMvc（Boot 4 拆包后在
             org.springframework.boot.webmvc.test.autoconfigure） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
